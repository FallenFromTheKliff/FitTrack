{
  "name": "@fittrack/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "set EXPO_UNSTABLE_HEADLESS=1&& node ./node_modules/expo/bin/cli start --lan",
    "android": "set EXPO_UNSTABLE_HEADLESS=1&& node ./node_modules/expo/bin/cli start --android",
    "ios": "set EXPO_UNSTABLE_HEADLESS=1&& node ./node_modules/expo/bin/cli start --ios",
    "web": "set EXPO_UNSTABLE_HEADLESS=1&& node ./node_modules/expo/bin/cli start --web",
    "lint": "..\\web\\node_modules\\.bin\\eslint.cmd . --ext .ts,.tsx --config ..\\web\\eslint.config.mjs --rule no-empty:warn --rule @typescript-eslint/no-unused-expressions:warn --rule @typescript-eslint/no-require-imports:off",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fittrack/app-config": "workspace:*",
    "@fittrack/app-core": "workspace:*",
    "@fittrack/api-client": "workspace:*",
    "@fittrack/hooks": "workspace:*",
    "@fittrack/query": "workspace:*",
    "@fittrack/types": "workspace:*",
    "@fittrack/ui": "workspace:*",
    "@fittrack/utils": "workspace:*",
    "@fittrack/validators": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/native": "^7.1.33",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.0",
    "expo-camera": "^55.0.9",
    "expo-font": "^55.0.4",
    "expo-haptics": "^55.0.8",
