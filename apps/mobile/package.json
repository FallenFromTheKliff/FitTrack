    "expo": "~55.0.0",
    "expo-camera": "^55.0.9",
    "expo-dev-client": "55.0.28",
    "expo-file-system": "55.0.10",
    "expo-font": "^55.0.4",
    "expo-haptics": "^55.0.8",
    "expo-image-picker": "^55.0.12",
    "expo-notifications": "^55.0.11",
