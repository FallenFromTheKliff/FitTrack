# =============================================================================
# FitTrack Python AI Microservice — Production Dockerfile
# FastAPI + LLaMA + MediaPipe + TensorFlow
# =============================================================================

FROM python:3.11-slim

WORKDIR /app

# System deps needed by MediaPipe and TensorFlow
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN addgroup --system --gid 1001 python \
    && adduser  --system --uid 1001 --ingroup python aiuser

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app source
COPY --chown=aiuser:python . .

USER aiuser

EXPOSE 8000

# Workers=1 keeps memory predictable on Railway's free/hobby tier
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]