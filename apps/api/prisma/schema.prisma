// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// FitTrack — Prisma Schema
// Team: Byte Bros · INF234
// Stack: NestJS · PostgreSQL · Prisma ORM
// =============================================================================

// =============================================================================
// S2 — AUTH & IDENTITY
// =============================================================================

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  role                 UserRole
  status               UserStatus @default(pending)
  email_verified_at    DateTime?  @db.Timestamptz(6)
  phone_verified_at    DateTime?  @db.Timestamptz(6)
  qr_code_token        String?    @unique @db.VarChar(64)
  qr_code_rotated_at   DateTime?  @db.Timestamptz(6)
  qr_code_expires_at   DateTime?  @db.Timestamptz(6)
  has_accepted_privacy Boolean    @default(false)
  privacy_accepted_at  DateTime?  @db.Timestamptz(6)
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?  @db.Timestamptz(6)

  // S2
  auth_identities                AuthIdentity[]
  refresh_tokens                 RefreshToken[]
  otp_verifications              OtpVerification[]
  // S3
  profile                        UserProfile?
  notification_prefs             NotificationPreference?
  deletion_requests              AccountDeletionRequest[]
  progress_metrics               ProgressMetric[]
  attendance_logs                AttendanceLog[]               @relation("attendee")
  scanned_attendance             AttendanceLog[]               @relation("scanner")
  app_feedback                   AppFeedback[]
  amenity_feedback               AmenityFeedback[]
  // S4
  subscriptions                  Subscription[]
  membership_card                MembershipCard?
  payments                       Payment[]
  payments_verified              Payment[]                     @relation("payment_verifier")
  // S5
  amenity_bookings               AmenityBooking[]
  // S6
  coach_profile                  CoachProfile?
  member_appointments            CoachAppointment[]            @relation("member")
  recurring_coaching_plans       RecurringCoachingPlan[]       @relation("recurring_plan_member")
  coach_reviews                  CoachReview[]
  client_relationships           CoachClientRelationship[]     @relation("member_rel")
  // S7
  training_plans                 TrainingPlan[]
  coach_assigned_plans           TrainingPlan[]                @relation("coach_trainer")
  workout_sessions               WorkoutSession[]
  exercise_logs                  ExerciseLog[]
  exercise_review_submissions    ExerciseReviewSubmission[]
  pose_sessions                  PoseSession[]
  // S8
  muscle_mastery                 MuscleMasteryProgress[]
  progression_source_events      ProgressionSourceEvent[]
  progression_grants             ProgressionGrantLedger[]
  progression_profile            UserProgressionProfile?
  seasonal_standings             SeasonalStanding[]
  seasonal_muscle_standings      SeasonalMuscleStanding[]
  milestone_progress             UserMilestoneProgress[]
  milestone_evidence_submissions MilestoneEvidenceSubmission[] @relation("milestone_evidence_submitter")
  milestone_evidence_reviews     MilestoneEvidenceSubmission[] @relation("milestone_evidence_reviewer")
  milestone_definitions_created  MilestoneDefinition[]         @relation("milestone_definition_creator")
  milestone_definitions_updated  MilestoneDefinition[]         @relation("milestone_definition_updater")
  milestone_definitions_archived MilestoneDefinition[]         @relation("milestone_definition_archiver")
  ranking_profile                RankingProfile?
  integrity_profile              IntegrityProfile?
  integrity_cases                IntegrityCase[]
  integrity_events               IntegrityEvent[]
  creator_profile                CreatorProfile?
  moderation_actions_taken       ModerationActionRecord[]      @relation("moderation_actor")
  moderation_actions_received    ModerationActionRecord[]      @relation("moderation_target")
  // S9
  tdee_profiles                  TdeeProfile[]
  macro_targets                  MacroTarget[]
  nutrition_logs                 NutritionLog[]
  // S10
  sale_transactions_processed    SaleTransaction[]             @relation("processed_by")
  sale_transactions_customer     SaleTransaction[]             @relation("sale_customer")
  equipment_writeoffs            EquipmentWriteOff[]
  // S11
  ai_chat_sessions               AiChatSession[]
  ai_interaction_logs            AiInteractionLog[]
  // S12
  notifications                  Notification[]

  // S14
  audit_logs AuditLog[]

  // S16
  gym_chat_sessions               GymChatSession[]
  gym_chat_interaction_logs       GymChatInteractionLog[]
  // S17
  business_insight_runs_requested BusinessInsightRun[]

  @@index([status])
  @@index([role])
  @@map("users")
}

enum UserRole {
  admin
  staff
  member
  coach
}

enum UserStatus {
  pending
  active
  suspended
  banned
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid())
  userId      String                       @map("user_id") @db.Uuid
  reason      String?
  status      AccountDeletionRequestStatus @default(pending)
  reviewedBy  String?                      @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?                    @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes String?                      @map("review_notes")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("account_deletion_requests")
}

enum AccountDeletionRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model AuthIdentity {
  id               String       @id @default(uuid()) @db.Uuid
  user_id          String       @db.Uuid
  provider         AuthProvider
  identifier       String       @db.VarChar(255) // email address or E.164 phone number
  credential_hash  String?      @db.VarChar(255) // bcrypt(12) — email provider only
  provider_user_id String?      @db.VarChar(255) // Google user ID — google provider only
  is_primary       Boolean      @default(false)
  verified_at      DateTime?    @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider, identifier])
  @@index([provider, identifier])
  @@map("auth_identities")
}

// One account can be accessed via email, phone, and/or google simultaneously
enum AuthProvider {
  email
  phone
  google
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  token_hash   String    @unique @db.VarChar(255) // SHA-256 of the raw token UUID
  device_info  String?   @db.VarChar(255) // User-Agent header
  ip_address   String?   @db.VarChar(45) // IPv4 or IPv6
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  rotated_from String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenRotation", fields: [rotated_from], references: [id])
  children RefreshToken[] @relation("TokenRotation")

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  user_id      String     @db.Uuid
  channel      OtpChannel
  purpose      OtpPurpose
  code_hash    String     @db.VarChar(255) // SHA-256 of the 6-digit OTP
  expires_at   DateTime   @db.Timestamptz(6)
  attempts     Int        @default(0) @db.SmallInt
  locked_until DateTime?  @db.Timestamptz(6)
  consumed_at  DateTime?  @db.Timestamptz(6)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@index([expires_at])
  @@map("otp_verifications")
}

enum OtpChannel {
  email
  sms
}

enum OtpPurpose {
  registration
  login_2fa
  password_reset
  phone_verify
}

// =============================================================================
// S3 — USER PROFILE & PROGRESS
// =============================================================================

model UserProfile {
  id             String         @id @default(uuid()) @db.Uuid
  user_id        String         @unique @db.Uuid
  first_name     String         @db.VarChar(100)
  last_name      String         @db.VarChar(100)
  phone          String?        @db.VarChar(20) // stored here; verified via AuthIdentity
  date_of_birth  DateTime?      @db.Date
  gender         Gender?
  weight_kg      Decimal?       @db.Decimal(5, 2)
  height_cm      Decimal?       @db.Decimal(5, 2)
  activity_level ActivityLevel?
  fitness_goal   FitnessGoal?
  avatar_url     String?        @db.VarChar(500)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AppFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  category   String   @default("general") @db.VarChar(40)
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("app_feedback")
}

enum Gender {
  male
  female
  other
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum FitnessGoal {
  bulking
  cutting
  maintenance
  sport_specific
}

model ProgressMetric {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  weight_kg      Decimal? @db.Decimal(5, 2)
  height_cm      Decimal? @db.Decimal(5, 2)
  body_fat_pct   Decimal? @db.Decimal(4, 2)
  muscle_mass_kg Decimal? @db.Decimal(5, 2)
  waist_cm       Decimal? @db.Decimal(5, 2)
  chest_cm       Decimal? @db.Decimal(5, 2)
  notes          String?
  recorded_at    DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, recorded_at(sort: Desc)])
  @@map("progress_metrics")
}

model NotificationPreference {
  id                               String   @id @default(uuid()) @db.Uuid
  user_id                          String   @unique @db.Uuid
  subscription_expiring_email      Boolean  @default(true)
  subscription_expiring_sms        Boolean  @default(false)
  subscription_expired_email       Boolean  @default(true)
  booking_confirmed_email          Boolean  @default(true)
  booking_confirmed_sms            Boolean  @default(false)
  booking_cancelled_email          Boolean  @default(true)
  venue_booking_reminder_email     Boolean  @default(true)
  venue_booking_reminder_sms       Boolean  @default(false)
  booking_no_show_email            Boolean  @default(true)
  appointment_confirmed_email      Boolean  @default(true)
  appointment_confirmed_sms        Boolean  @default(false)
  coach_appointment_reminder_email Boolean  @default(true)
  coach_appointment_reminder_sms   Boolean  @default(false)
  appointment_completed_email      Boolean  @default(true)
  appointment_cancelled_email      Boolean  @default(true)
  rank_up_email                    Boolean  @default(true)
  payment_confirmed_email          Boolean  @default(true)
  payment_failed_email             Boolean  @default(true)
  ai_session_archived_email        Boolean  @default(true)
  system_email                     Boolean  @default(true)
  created_at                       DateTime @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AttendanceLog {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  scanned_by   String?   @db.Uuid
  check_in_at  DateTime  @db.Timestamptz(6)
  check_out_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  user    User  @relation("attendee", fields: [user_id], references: [id])
  scanner User? @relation("scanner", fields: [scanned_by], references: [id])

  @@index([user_id, check_in_at(sort: Desc)])
  @@index([check_in_at])
  @@map("attendance_logs")
}

// =============================================================================
// S4 — SUBSCRIPTION & PAYMENTS
// =============================================================================

model MembershipPlan {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(100)
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("PHP") @db.VarChar(3)
  duration_days     Int
  features          Json     @default("{}")
  sort_order        Int      @default(0) @db.SmallInt
  includes_coaching Boolean  @default(false)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]

  @@index([is_active, sort_order])
  @@map("membership_plans")
}

model MembershipCatalogSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  membership_card_price Decimal  @default(400) @db.Decimal(10, 2)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  @@map("membership_catalog_settings")
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  user_id             String             @db.Uuid
  plan_id             String             @db.Uuid
  payment_id          String?            @db.Uuid
  status              SubscriptionStatus @default(pending_payment)
  starts_at           DateTime?          @db.Timestamptz(6)
  expires_at          DateTime?          @db.Timestamptz(6)
  warned_7d_at        DateTime?          @db.Timestamptz(6)
  warned_3d_at        DateTime?          @db.Timestamptz(6)
  warned_1d_at        DateTime?          @db.Timestamptz(6)
  cancelled_at        DateTime?          @db.Timestamptz(6)
  cancellation_reason String?
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)

  user User           @relation(fields: [user_id], references: [id])
  plan MembershipPlan @relation(fields: [plan_id], references: [id])

  // Partial unique via raw migration:
  // CREATE UNIQUE INDEX subscriptions_one_active_per_user
  //   ON subscriptions(user_id)
  //   WHERE status IN ('active','past_due','pending_payment');
  @@index([user_id])
  @@index([expires_at, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  pending_payment
  active
  past_due
  expired
  cancelled
  suspended
}

model MembershipCard {
  id            String               @id @default(uuid()) @db.Uuid
  user_id       String               @unique @db.Uuid
  status        MembershipCardStatus @default(active)
  source        MembershipCardSource @default(admin_grant)
  price         Decimal              @default(400) @db.Decimal(10, 2)
  purchased_at  DateTime             @default(now()) @db.Timestamptz(6)
  verified_at   DateTime?            @db.Timestamptz(6)
  verified_by   String?              @db.Uuid
  activated_at  DateTime?            @db.Timestamptz(6)
  revoked_at    DateTime?            @db.Timestamptz(6)
  revoked_by    String?              @db.Uuid
  revoke_reason String?
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime             @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([verified_by])
  @@index([revoked_by])
  @@map("membership_cards")
}

enum MembershipCardStatus {
  pending_verification
  active
  revoked
}

enum MembershipCardSource {
  cash
  paymongo
  admin_grant
  admin_repair
}

model Payment {
  id               String          @id @default(uuid()) @db.Uuid
  user_id          String          @db.Uuid
  payable_type     PayableType
  payable_id       String          @db.Uuid
  payment_stage    PaymentStage
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("PHP") @db.VarChar(3)
  provider         PaymentProvider
  provider_ref     String?         @unique @db.VarChar(255)
  gateway_event_id String?         @unique @db.VarChar(255)
  idempotency_key  String          @unique @db.VarChar(128)
  status           PaymentStatus   @default(pending)
  gateway_metadata Json?
  screenshot_url   String?         @db.VarChar(500)
  rejection_reason String?
  verified_by      String?         @db.Uuid
  verified_at      DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  user     User  @relation(fields: [user_id], references: [id])
  verifier User? @relation("payment_verifier", fields: [verified_by], references: [id])

  @@index([payable_type, payable_id])
  @@index([user_id, status])
  @@index([status])
  @@map("payments")
}

enum PayableType {
  subscription
  booking
  coaching
  recurring_coaching
  product
  membership_card
}

enum PaymentStage {
  downpayment
  balance
  full
}

enum PaymentProvider {
  paymongo
  cash
}

enum PaymentStatus {
  pending
  processing
  awaiting_verification
  completed
  failed
}

// =============================================================================
// S5 — FACILITY BOOKINGS
// =============================================================================

model Amenity {
  id                    String      @id @default(uuid()) @db.Uuid
  name                  String      @db.VarChar(100)
  type                  AmenityType
  description           String?
  capacity              Int         @default(1)
  hourly_rate           Decimal     @default(0) @db.Decimal(8, 2)
  minimum_hours         Int?
  icon_key              String?     @db.VarChar(100)
  grid_column           Int?
  grid_row              Int?
  grid_width            Int?
  grid_height           Int?
  image_url             String?     @db.VarChar(500)
  is_reservable         Boolean?
  display_order         Int?
  floor_id              String?     @db.VarChar(20)
  requires_subscription Boolean     @default(false)
  is_active             Boolean     @default(true)
  created_at            DateTime    @default(now()) @db.Timestamptz(6)
  updated_at            DateTime    @updatedAt @db.Timestamptz(6)

  bookings AmenityBooking[]
  feedback AmenityFeedback[]

  @@index([is_active, type])
  @@map("amenities")
}

model FacilityFloorPlanMedia {
  floor_id   String   @id @db.VarChar(20)
  image_url  String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("facility_floor_plan_media")
}

enum AmenityType {
  basketball_court
  boxing_ring
  other
}

model AmenityBooking {
  id                  String        @id @default(uuid()) @db.Uuid
  user_id             String        @db.Uuid
  amenity_id          String        @db.Uuid
  coach_id            String?       @db.Uuid
  status              BookingStatus @default(pending)
  starts_at           DateTime      @db.Timestamptz(6)
  ends_at             DateTime      @db.Timestamptz(6)
  total_amount        Decimal       @db.Decimal(10, 2)
  downpayment_amount  Decimal       @db.Decimal(10, 2)
  balance_amount      Decimal       @db.Decimal(10, 2)
  downpayment_paid_at DateTime?     @db.Timestamptz(6)
  balance_paid_at     DateTime?     @db.Timestamptz(6)
  cancelled_at        DateTime?     @db.Timestamptz(6)
  completed_at        DateTime?     @db.Timestamptz(6)
  notes               String?
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @updatedAt @db.Timestamptz(6)

  user    User          @relation(fields: [user_id], references: [id])
  amenity Amenity       @relation(fields: [amenity_id], references: [id])
  coach   CoachProfile? @relation(fields: [coach_id], references: [id])

  @@index([user_id])
  @@index([amenity_id, starts_at, ends_at])
  @@index([coach_id, starts_at, ends_at])
  @@index([status])
  @@map("amenity_bookings")
}

model AmenityFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  amenity_id String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Int      @default(5) @db.SmallInt
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  amenity Amenity @relation(fields: [amenity_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([amenity_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@map("amenity_feedback")
}

enum BookingStatus {
  pending // downpayment not yet received
  confirmed // payment settled; booking is active
  balance_pending // on arrival; balance not yet collected
  completed // session/booking has been marked done
  cancelled // cancelled (downpayment forfeited)
  no_show // did not arrive
}

// =============================================================================
// S6 — COACHING
// =============================================================================

model CoachProfile {
  id                               String            @id @default(uuid()) @db.Uuid
  user_id                          String?           @unique @db.Uuid
  display_name                     String?           @db.VarChar(160)
  contact_email                    String?           @db.VarChar(255)
  contact_phone                    String?           @db.VarChar(40)
  specialization                   String?           @db.VarChar(255)
  bio                              String?
  certification                    String?           @db.VarChar(255)
  hourly_rate                      Decimal           @default(0) @db.Decimal(8, 2)
  monthly_rate                     Decimal           @default(0) @db.Decimal(10, 2)
  monthly_session_count            Int               @default(0) @db.SmallInt
  monthly_session_duration_minutes Int               @default(60) @db.SmallInt
  monthly_offer_description        String?           @db.VarChar(500)
  monthly_offer_active             Boolean           @default(false)
  gym_commission_pct               Decimal           @default(20) @db.Decimal(5, 2)
  schedule_type                    CoachScheduleType @default(part_time)
  average_rating                   Decimal?          @db.Decimal(3, 2)
  rating_count                     Int               @default(0)
  is_available_for_booking         Boolean           @default(true)
  created_at                       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime          @updatedAt @db.Timestamptz(6)

  user                 User?                     @relation(fields: [user_id], references: [id])
  appointments         CoachAppointment[]
  recurring_plans      RecurringCoachingPlan[]
  amenity_bookings     AmenityBooking[]
  reviews              CoachReview[]
  availability_slots   CoachAvailabilitySlot[]
  client_relationships CoachClientRelationship[] @relation("coach_rel")

  @@index([is_available_for_booking, average_rating(sort: Desc)])
  @@map("coach_profiles")
}

model CoachAppointment {
  id                         String                         @id @default(uuid()) @db.Uuid
  user_id                    String                         @db.Uuid
  coach_id                   String                         @db.Uuid
  recurring_plan_id          String?                        @db.Uuid
  recurring_schedule_item_id String?                        @unique @db.Uuid
  status                     AppointmentStatus              @default(pending_coach)
  recurring_state            RecurringCoachingSessionState?
