{
  "version": 1,
  "artifactsDir": ".artifacts/playwright-mcp",
  "requirePlaywrightMcp": true,
  "capture": {
    "networkRequests": true,
    "consoleMessages": true,
    "trace": true,
    "failureScreenshot": true
  },
  "apps": {
    "web": {
      "baseUrl": "http://127.0.0.1:8080",
      "loginRoute": "/login",
      "defaultProtectedRoute": "/dashboard",
      "viewport": {
        "width": 1440,
        "height": 900
      },
      "allowedRoles": ["ADMIN", "STAFF"],
      "deniedRoles": ["USER", "COACH"],
      "notes": "Use the admin or staff web flow and verify the touched endpoints through Playwright network capture."
    },
    "mobile": {
      "baseUrl": "http://127.0.0.1:8081",
      "loginRoute": "/login",
      "defaultProtectedRoute": "/",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "mode": "expo-web",
      "allowedRoles": ["USER"],
      "deniedRoles": ["ADMIN", "STAFF", "COACH"],
      "notes": "Use Expo web for Playwright verification and treat it as the browser-driven mobile surface."
    }
  },
  "verificationPolicy": {
    "requireWebFlow": true,
    "requireMobileFlow": true,
    "requireTouchedEndpointEvidence": true,
    "requireNegativePathWhenRoleSensitive": true
  }
}
