{
  "language": "typescript",
  "frameworks": ["nextjs", "expo"],
  "monorepo": "turborepo",
  "rules": [
    ".ai-frontend/agent.md",
    ".ai-frontend/AI_CONTEXT.md",
    ".ai-frontend/monorepo.md",
    ".ai-frontend/style.md",
    ".ai-frontend/context-protection.md",
    ".ai-frontend/component-rules.md",
    ".ai-frontend/performance.md"
  ],
  "tools": ["filesystem", "git", "search", "serena", "context7", "playwright", "notion"],
  "apps": {
    "mobile": {
      "path": "apps/mobile",
      "framework": "expo",
      "orientation": "member-facing",
      "router": "expo-router",
      "devPort": 8081
    },
    "web": {
      "path": "apps/web",
      "framework": "nextjs",
      "orientation": "admin-staff-facing",
      "router": "next-app-router",
      "devPort": 8080
    }
  },
  "contractSources": {
    "primary": ["packages/api-client", "packages/query", "packages/app-core", "packages/types", "packages/validators"],
    "supporting": ["Notion FITTRACK: Backup Log", "Swagger MCP when runtime API truth is needed"],
    "backendEdits": "forbidden unless explicitly requested"
  },
  "restrictions": {
    "backend_changes": false,
    "context_crud_modification": false,
    "javascript_files": false,
    "performance_regression": false,
    "cross_app_style_bleed": false
  }
}