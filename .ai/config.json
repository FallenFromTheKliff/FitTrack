{
  "language": "typescript",
  "frameworks": ["nextjs", "expo"],
  "monorepo": "turborepo",
  "rules": [
    ".ai/agent.md",
    ".ai/AI_CONTEXT.md",
    ".ai/monorepo.md",
    ".ai/style.md",
    ".ai/context-protection.md",
    ".ai/component-rules.md",
    ".ai/performance.md"
  ],
  "tools": ["filesystem", "git", "search"],
  "apps": {
    "mobile": {
      "path": "apps/mobile",
      "framework": "expo",
      "orientation": "member-facing",
      "router": "expo-router",
      "devPort": 8081
    },
    "web": {
      "path": "apps/web",
      "framework": "nextjs",
      "orientation": "admin-staff-facing",
      "router": "next-app-router",
      "devPort": 8080
    }
  },
  "restrictions": {
    "backend_changes": false,
    "context_crud_modification": false,
    "ui_redesign": false,
    "javascript_files": false,
    "performance_regression": false,
    "cross_app_style_bleed": false
  }
}