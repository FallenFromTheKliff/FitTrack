{
  "name": "fittrack",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev",
    "infra:up": "docker compose -f docker-compose.local-infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.local-infra.yml down",
    "infra:logs": "docker compose -f docker-compose.local-infra.yml logs --tail=100",
    "install:api": "pnpm install --filter @fittrack/api...",
    "dev:api": "pnpm --filter @fittrack/api run start:dev",
    "dev:ai": "node tasks/integration-builder/dev-ai-service.mjs",
    "dev:stack": "node tasks/integration-builder/dev-stack-supervisor.mjs start --no-mobile-web && pnpm --dir apps/mobile run dev",
    "dev:stack:ai": "node tasks/integration-builder/dev-stack-supervisor.mjs start --include-ai --no-mobile-web && pnpm --dir apps/mobile run dev",
    "dev:stack:web": "node tasks/integration-builder/dev-stack-supervisor.mjs start",
    "dev:stack:web:ai": "node tasks/integration-builder/dev-stack-supervisor.mjs start --include-ai",
    "dev:stack:web:ai:mobile-web-deployed": "node scripts/dev-stack-web-ai-mobile-deployed.js",
    "dev:stack:paymongo:tunnel": "node tasks/integration-builder/paymongo-tunnel.mjs",
    "dev:stack:status": "node tasks/integration-builder/dev-stack-supervisor.mjs status",
    "dev:stack:stop": "node tasks/integration-builder/dev-stack-supervisor.mjs stop",
    "dev:web": "pnpm --filter @fittrack/web run dev",
    "dev:mobile": "pnpm --filter @fittrack/mobile run dev",
    "dev:mobile:web": "pnpm --dir apps/mobile run web -- --port 8081",
    "build:mobile:apk": "pnpm --dir apps/mobile run android:apk",
    "install:mobile:apk": "pnpm run build:mobile:apk -- --install",
    "build:mobile:ipa": "pnpm --dir apps/mobile run ios:ipa",
    "install:mobile:ipa": "pnpm --dir apps/mobile run ios:ipa -- --install-only",
    "db:ensure-local": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/ensure-local-db.ts",
    "db:generate": "pnpm --filter @fittrack/api exec npx prisma generate && node tasks/ensure-prisma-client-link.mjs",
    "db:push": "pnpm --filter @fittrack/api exec npx prisma db push --accept-data-loss --schema=prisma/schema.prisma",
    "db:bootstrap": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/bootstrap-defaults.ts",
    "db:migrate": "pnpm --filter @fittrack/api exec npx prisma migrate dev",
    "db:migrate:generate": "pnpm db:migrate && pnpm db:generate",
    "db:seed": "pnpm --filter @fittrack/api exec npx prisma db seed",
    "db:seed:realistic": "pnpm seed:realistic 180",
    "db:seed:dynamic": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-dynamic.ts --target=local --mode=reset --users=180",
    "db:seed:dynamic:additive": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-dynamic.ts --target=local --mode=additive --users=180",
    "db:seed:dynamic:railway": "railway run pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-dynamic.ts --target=railway --mode=additive --users=180",
    "db:seed:defense-demo": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-defense-demo-data.ts",
    "db:seed:test": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-test-data.ts --mode=reset",
    "db:seed:test:additive": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/seed-test-data.ts --mode=additive",
    "db:seed:test:report": "pnpm --filter @fittrack/api exec node -r ts-node/register prisma/report-test-data.ts",
    "seed:realistic": "node tasks/seed-realistic.mjs",
    "delete:user:railway": "node scripts/delete-user.js",
    "seed:realistic:railway": "railway run node tasks/seed-realistic.mjs --target=railway --mode=additive",
    "redis:reset-auth": "node tasks/reset-redis-cache.mjs --target=local --scope=auth",
    "redis:reset-cache": "node tasks/reset-redis-cache.mjs --target=local --scope=all",
    "redis:reset-auth:railway": "railway run --service Redis node tasks/reset-redis-cache.mjs --target=railway --scope=auth --allow-remote-reset --confirm=RESET_REMOTE_REDIS_CACHE",
    "redis:reset-cache:railway": "railway run --service Redis node tasks/reset-redis-cache.mjs --target=railway --scope=all --allow-remote-reset --confirm=RESET_REMOTE_REDIS_CACHE",
    "db:purge": "pnpm --filter @fittrack/api run db:purge",
    "db:studio": "pnpm --filter @fittrack/api exec npx prisma studio",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:seed:dynamic": "pnpm --filter @fittrack/api run test:seed:dynamic",
    "test:ui": "playwright test",
    "test:ui:real-data": "node tasks/run-real-data-e2e.mjs",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report .artifacts/playwright/report",
    "test:ui:golden": "playwright test --config=playwright.storybook.config.ts tests/ui/golden-archetypes.spec.ts",
    "test:ui:visual": "playwright test --config=playwright.visual.config.ts",
    "test:ui:visual:debug": "playwright-cli open http://localhost:8080",
    "test:ui:visual:report": "playwright show-report .artifacts/playwright/visual-report",
    "test:ui:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "storybook": "pnpm --filter @fittrack/web storybook",
    "storybook:build": "pnpm --filter @fittrack/web storybook:build",
    "registry:build": "pnpm --dir apps/web registry:build",
    "registry:validate": "node scripts/validate-fittrack-tooling.mjs",
    "ui-quality:check": "pnpm registry:build && pnpm registry:validate && pnpm storybook:build",
    "clean": "node tasks/clean-workspaces.mjs",
    "refresh:packages-db-client": "pnpm clean && pnpm install && pnpm db:migrate:generate",
    "deploy:railway": "node tasks/deploy-railway.mjs"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.2.1",
    "localtunnel": "^2.0.2",
    "swagger-mcp": "^1.0.8",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "@shopify/react-native-skia",
      "bcrypt",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.83.4": "patches/@react-native__gradle-plugin@0.83.4.patch",
      "@shopify/react-native-skia@2.6.2": "patches/@shopify__react-native-skia@2.6.2.patch",
      "expo-modules-core@55.0.14": "patches/expo-modules-core@55.0.14.patch",
      "react-native-reanimated@4.2.2": "patches/react-native-reanimated@4.2.2.patch",
      "react-native-vision-camera@4.7.3": "patches/react-native-vision-camera@4.7.3.patch",
      "react-native-worklets-core@1.6.3": "patches/react-native-worklets-core@1.6.3.patch",
      "react-native-worklets@0.7.4": "patches/react-native-worklets@0.7.4.patch",
      "vision-camera-pose-detector@1.1.0": "patches/vision-camera-pose-detector@1.1.0.patch"
    }
  }
}

