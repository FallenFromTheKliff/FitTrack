# Common App
NODE_ENV=production
PORT=3001
API_PREFIX=v1
APP_NAME=FitTrack
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
OTP_EXPIRY_MINUTES=5

# Frontend Public API URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fittrack
DATABASE_URL=postgresql://postgres:postgres@db:5432/fittrack

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (canonical)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=FitTrack
MAIL_FROM_ADDRESS=no-reply@fittrack.com

# Legacy mail aliases kept for compatibility while older paths are cleaned up
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SUCCESS_URL=
PAYMONGO_CANCEL_URL=
PAYMONGO_WEBHOOK_SECRET_KEY=
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,card

# AI service
AI_API_BASE_URL=http://ai-microservice:8000
AI_REQUEST_TIMEOUT_MS=10000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_INSIGHT_MODEL=openrouter/openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=FitTrack

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
