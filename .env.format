# Common App
NODE_ENV=development
PORT=3001
API_PREFIX=v1
APP_NAME=FitTrack
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
OTP_EXPIRY_MINUTES=5

# Frontend Public API URLs
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://your-public-r2-base-url
NEXT_PUBLIC_R2_DEFAULT_AVATAR_DIR=defaults/avatars
EXPO_PUBLIC_API_URL=http://localhost:3001/v1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fittrackdb
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fittrackdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (canonical)
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM_NAME=FitTrack
MAIL_FROM_ADDRESS=replace-with-mail-from-address

# Legacy mail aliases kept for compatibility while older paths are cleaned up
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# Twilio
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_BUCKET=fittrack-assets
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://your-public-r2-base-url
R2_ANALYTICS_API_TOKEN=replace-with-r2-analytics-api-token
R2_ENFORCE_UPLOAD_GUARD=true
R2_STORAGE_LIMIT_BYTES=10000000000
R2_MIN_FREE_BYTES=1000000000
UPLOAD_MAX_FILE_SIZE_BYTES=26214400

# PayMongo
PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
PAYMONGO_PUBLIC_KEY=replace-with-paymongo-public-key
PAYMONGO_API_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SUCCESS_URL=http://127.0.0.1:8080/payments/success
PAYMONGO_CANCEL_URL=http://127.0.0.1:8080/payments/cancel
PAYMONGO_WEBHOOK_SECRET_KEY=replace-with-paymongo-webhook-secret-key
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,card
PAYMONGO_TUNNEL_SUBDOMAIN=replace-with-localtunnel-subdomain

# AI service
AI_API_BASE_URL=http://127.0.0.1:8000
AI_REQUEST_TIMEOUT_MS=60000
# Per-attempt OpenRouter timeout; keep below AI_REQUEST_TIMEOUT_MS after conversion to seconds.
OPENROUTER_ASSISTANT_TIMEOUT_SECONDS=25

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_ASSISTANT_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ASSISTANT_PLAN_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ASSISTANT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ASSISTANT_FALLBACK_MODEL=openrouter/free
OPENROUTER_BUSINESS_INSIGHT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_INSIGHT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_INSIGHT_FALLBACK_MODEL=openrouter/free
OPENROUTER_FREE_MODEL_FALLBACK=openrouter/free
OPENROUTER_POSE_MODEL=qwen/qwen3.6-plus:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=FitTrack

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
